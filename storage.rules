rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Dad's Photos Folder
    // Public visitors can view/read photos.
    // Only authenticated admins can upload or delete photos.
    match /dad-photos/{photoId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Birthday Music Folder
    // Public visitors can stream/read music.
    // Only authenticated admins can upload or delete music tracks.
    match /birthday-music/{musicId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 30 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null;
    }

    // Default fallback rule: public read, authenticated write/delete
    match /{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }
  }
}
